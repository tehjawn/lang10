# Both variables are optional. Without them Lang10 runs in local-only mode:
# every lesson works, progress is saved in the browser, accounts are disabled.

# Postgres connection string. On Railway, add a Postgres service and reference
# it as ${{Postgres.DATABASE_URL}} in this service's variables.
DATABASE_URL=

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=
